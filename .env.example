# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Budget ---
BUDGET_TOTAL_USD=20.00
BUDGET_KILL_USD=18.00

# --- Voice (Vapi) ---
# Required for live voice calls; not needed for text-mode runs
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Number Vapi will dial for the demo recording (E.164, e.g. +14155551234)
DEMO_BORROWER_PHONE=

# --- Voice routing ---
# "text" = Agent 2 runs in text-mode (cheap, used for learning loop)
# "vapi" = Agent 2 makes a real outbound call
# Both code paths are always built; this flag chooses which one runs.
VOICE_MODE=text

# Public URL for Vapi webhook (set when running real calls; e.g. Cloudflare Tunnel)
PUBLIC_WEBHOOK_URL=

# --- Storage ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=riverline
POSTGRES_PASSWORD=riverline
POSTGRES_DB=riverline
REDIS_URL=redis://localhost:6379/0

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=riverline

# --- Reproducibility ---
RNG_SEED=20260512
